<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PeekVPN.App.App"
             xmlns:local="using:PeekVPN.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PeekVPN/Styles/Colors.axaml"/>
                <ResourceInclude Source="avares://PeekVPN/Styles/Brushes.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppFontFamily">avares://PeekVPN/Assets/Inter.ttf#Inter</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://PeekVPN/Styles/Controls.axaml"/>

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        </Style>
        <Style Selector="SelectableTextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        </Style>
        <Style Selector="Label">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        </Style>
    </Application.Styles>
</Application>
