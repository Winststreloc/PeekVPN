<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>PeekVPN.App</RootNamespace>
        <AssemblyName>PeekVPN</AssemblyName>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationIcon>Assets/main.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
        <AvaloniaResource Include="Styles\**" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Localization\Strings.resx">
            <Generator></Generator>
            <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
        </EmbeddedResource>
        <Compile Update="Localization\Strings.Designer.cs">
            <DependentUpon>Strings.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
        <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
        <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.1" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="SkiaSharp" Version="3.119.4" />
        <PackageReference Include="Svg.Skia" Version="3.0.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PeekVPN.Core\PeekVPN.Core.csproj" />
        <ProjectReference Include="..\PeekVPN.Infrastructure\PeekVPN.Infrastructure.csproj" />
    </ItemGroup>
</Project>
