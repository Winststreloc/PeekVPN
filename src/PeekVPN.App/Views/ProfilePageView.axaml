<UserControl
    x:Class="PeekVPN.App.Views.ProfilePageView"
    x:DataType="vm:ProfilePageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:vm="using:PeekVPN.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="980" Spacing="{StaticResource Space.Xxl}">
            <StackPanel Spacing="{StaticResource Space.Xs}">
                <TextBlock Classes="PageTitle" FontSize="{StaticResource Type.Display}" FontWeight="Bold" Text="{Binding Title}" />
                <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding Subtitle}" />
            </StackPanel>

            <Border Classes="Card" Padding="{StaticResource Inset.Xxl}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space.Xl}">
                    <Border Background="{DynamicResource Brush.Accent.Primary}" CornerRadius="{StaticResource Radius.Full}" Height="{StaticResource Size.Avatar}" Width="{StaticResource Size.Avatar}">
                        <TextBlock FontSize="25" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnAccent}" HorizontalAlignment="Center" Text="AM" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding EmailAddress}" />
                    </StackPanel>
                    <Button Classes="OutlineCta" Content="{Binding EditProfile}" Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space.Xxl}">
                <Border Classes="Card">
                    <StackPanel Spacing="{StaticResource Space.Xxl}">
                        <TextBlock Classes="SectionTitle" FontSize="{StaticResource Type.Title}" FontWeight="SemiBold" Text="{Binding AccountTitle}" />
                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding AccountSubtitle}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4"><TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding MemberSinceLabel}" /><TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding MemberSinceValue}" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding DevicesLabel}" /><TextBlock FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" Text="{Binding DevicesValue}" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Classes="Card" Grid.Column="1">
                    <StackPanel Spacing="{StaticResource Space.Xxl}">
                        <TextBlock Classes="SectionTitle" FontSize="{StaticResource Type.Title}" FontWeight="SemiBold" Text="{Binding ProtectionTitle}" />
                        <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{Binding ProtectionSubtitle}" TextWrapping="Wrap" />
                        <Border Background="{DynamicResource Brush.Status.ActiveBadge}" CornerRadius="{StaticResource Radius.Nav}" Padding="{StaticResource Inset.Notice}">
                            <TextBlock Foreground="{DynamicResource Brush.Status.ActiveBadgeText}" FontWeight="SemiBold" Text="{Binding ProtectionValue}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Background="{DynamicResource Brush.Background.ButtonDark}"
                CornerRadius="{StaticResource Radius.Card}"
                Padding="{StaticResource Inset.Xxl}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space.Xl}">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="{StaticResource Type.Title}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.OnDark}" Text="{Binding PlanValue}" />
                        <TextBlock Foreground="{DynamicResource Brush.Text.OnDark}" Opacity="0.8" Text="{Binding RenewsLabel}" />
                        <TextBlock Foreground="{DynamicResource Brush.Text.OnDark}" Text="{Binding RenewsValue}" />
                    </StackPanel>
                    <Button Classes="PrimaryCta" Content="{Binding ManagePlan}" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
