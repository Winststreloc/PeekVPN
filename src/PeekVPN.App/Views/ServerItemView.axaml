<UserControl
    x:Class="PeekVPN.App.Views.ServerItemView"
    x:DataType="vm:ServerItemViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:conv="using:PeekVPN.App.Converters"
    xmlns:ctrl="using:PeekVPN.App.Controls"
    xmlns:vm="using:PeekVPN.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Panel
        Classes="ServerRowShell"
        Classes.StateConnected="{Binding IsConnectedHighlight}"
        Classes.StateConnecting="{Binding IsConnectingHighlight}"
        Classes.StateIdle="{Binding IsIdle}"
        Classes.StatePaused="{Binding IsPausedHighlight}">
        <Border Classes="ServerRowBg" />
        <Rectangle Classes="ServerRowDash" />
        <Button
            Classes="ServerRow"
            Command="{Binding ConnectServerCommand}"
            CommandParameter="{Binding}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space.Sm}">
                <Border
                    Background="{DynamicResource Brush.Background.IconMuted}"
                    ClipToBounds="True"
                    CornerRadius="{StaticResource Radius.Xl}"
                    Height="{StaticResource Size.Icon.Sm}"
                    IsHitTestVisible="False"
                    VerticalAlignment="Center"
                    Width="{StaticResource Size.Icon.Sm}">
                    <Panel>
                        <TextBlock
                            FontSize="{StaticResource Type.Micro}"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            HorizontalAlignment="Center"
                            Text="{Binding CountryCode}"
                            VerticalAlignment="Center" />
                        <ctrl:SvgImage
                            HorizontalAlignment="Stretch"
                            RasterWidth="56"
                            SourceUri="{Binding FlagUri}"
                            Stretch="UniformToFill"
                            VerticalAlignment="Stretch" />
                    </Panel>
                </Border>
                <StackPanel Grid.Column="1" IsHitTestVisible="False" Spacing="0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="{StaticResource Type.Label}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="{Binding Country}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="{StaticResource Type.Micro}"
                        Foreground="{DynamicResource Brush.Text.Secondary}"
                        Text="{Binding CityLabel}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    IsHitTestVisible="False"
                    Orientation="Horizontal"
                    Spacing="{StaticResource Space.Xs}"
                    VerticalAlignment="Center">
                    <TextBlock
                        Classes="Mono"
                        FontSize="{StaticResource Type.Micro}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.Text.Secondary}"
                        Text="{Binding LatencyText}"
                        VerticalAlignment="Center" />
                    <Ellipse
                        Fill="{Binding ConnectionState, Converter={x:Static conv:ConnectionStateToBrushConverter.Instance}}"
                        Height="{StaticResource Size.Dot.Sm}"
                        VerticalAlignment="Center"
                        Width="{StaticResource Size.Dot.Sm}" />
                </StackPanel>
            </Grid>
        </Button>
    </Panel>
</UserControl>
