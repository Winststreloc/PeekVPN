<UserControl
    x:Class="PeekVPN.App.Views.ConnectionPanelView"
    x:DataType="vm:ConnectionPanelViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:stateViews="using:PeekVPN.App.Views.ConnectionStates"
    xmlns:stateVm="using:PeekVPN.App.ViewModels"
    xmlns:vm="using:PeekVPN.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.DataTemplates>
        <DataTemplate DataType="stateVm:DisconnectedStateViewModel">
            <stateViews:DisconnectedStateView />
        </DataTemplate>
        <DataTemplate DataType="stateVm:ConnectingStateViewModel">
            <stateViews:ConnectingStateView />
        </DataTemplate>
        <DataTemplate DataType="stateVm:ConnectedStateViewModel">
            <stateViews:ConnectedStateView />
        </DataTemplate>
        <DataTemplate DataType="stateVm:PausedStateViewModel">
            <stateViews:PausedStateView />
        </DataTemplate>
        <DataTemplate DataType="stateVm:DisconnectingStateViewModel">
            <stateViews:DisconnectingStateView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Border Classes="Card" Padding="16">
        <ContentControl Content="{Binding ActiveState}" />
    </Border>
</UserControl>
