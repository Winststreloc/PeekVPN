<UserControl
    x:Class="PeekVPN.App.Views.ShellView"
    x:DataType="vm:ShellViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:conv="using:PeekVPN.App.Converters"
    xmlns:vm="using:PeekVPN.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Background="{DynamicResource Brush.Background.App}"
        ClipToBounds="True"
        CornerRadius="16">
        <Grid RowDefinitions="Auto,*">
            <Border
                Background="Transparent"
                Grid.Row="0"
                Height="60"
                Padding="20,0"
                PointerMoved="OnTitleBarPointerMoved"
                PointerPressed="OnTitleBarPointerPressed"
                PointerReleased="OnTitleBarPointerReleased">
                <Grid ColumnDefinitions="64,*,Auto">
                    <Border
                        Background="{DynamicResource Brush.Brand.Shield}"
                        CornerRadius="12"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="40">
                        <TextBlock
                            FontSize="20"
                            Foreground="{DynamicResource Brush.Text.OnDark}"
                            HorizontalAlignment="Center"
                            Text="P"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Margin="20,0"
                        Orientation="Horizontal"
                        Spacing="14"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="20"
                            FontWeight="Bold"
                            Text="{Binding AppTitle}"
                            VerticalAlignment="Center" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                            <Ellipse
                                Fill="{Binding Workspace.ConnectionPanel.ActiveState.State, Converter={x:Static conv:ConnectionStateToBrushConverter.Instance}, ConverterParameter=status}"
                                Height="8"
                                VerticalAlignment="Center"
                                Width="8" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{Binding Workspace.ConnectionPanel.ActiveState.State, Converter={x:Static conv:ConnectionStateToBrushConverter.Instance}, ConverterParameter=status}"
                                Text="{Binding Workspace.ConnectionPanel.ActiveState.StatusLabel}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <Button
                            Classes="GhostIcon"
                            Click="OnMinimizeClick"
                            ToolTip.Tip="Minimize">
                            <TextBlock
                                FontFamily="{StaticResource SegoeIcons}"
                                FontSize="14"
                                HorizontalAlignment="Center"
                                Text="&#xe921;"
                                VerticalAlignment="Center" />
                        </Button>
                        <Button
                            Classes="GhostIcon"
                            Click="OnMaximizeClick"
                            ToolTip.Tip="Maximize">
                            <TextBlock
                                FontFamily="{StaticResource SegoeIcons}"
                                FontSize="14"
                                HorizontalAlignment="Center"
                                Text="&#xe922;"
                                VerticalAlignment="Center" />
                        </Button>
                        <Button
                            Classes="GhostIcon"
                            Click="OnCloseClick"
                            ToolTip.Tip="Close">
                            <TextBlock
                                FontFamily="{StaticResource SegoeIcons}"
                                FontSize="14"
                                HorizontalAlignment="Center"
                                Text="&#xe8bb;"
                                VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid
                ColumnDefinitions="64,*"
                ColumnSpacing="16"
                Grid.Row="1"
                Margin="20,0,20,20">
                <Border
                    Background="{DynamicResource Brush.Background.Sidebar}"
                    CornerRadius="20"
                    Padding="10">
                    <Grid RowDefinitions="*,Auto">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <Button
                                Classes="NavIcon"
                                Classes.active="{Binding IsMapActive}"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="{x:Static vm:ShellPage.Map}"
                                ToolTip.Tip="{Binding NavMap}">
                                <Viewbox Height="20" Width="20">
                                    <Canvas Height="24" Width="24">
                                        <Ellipse
                                            Canvas.Left="2"
                                            Canvas.Top="2"
                                            Fill="Transparent"
                                            Height="20"
                                            Stroke="{DynamicResource Brush.Text.Primary}"
                                            StrokeThickness="1.8"
                                            Width="20" />
                                        <Ellipse
                                            Canvas.Left="8"
                                            Canvas.Top="2"
                                            Fill="Transparent"
                                            Height="20"
                                            Stroke="{DynamicResource Brush.Text.Primary}"
                                            StrokeThickness="1.5"
                                            Width="8" />
                                        <Line
                                            EndPoint="22,12"
                                            StartPoint="2,12"
                                            Stroke="{DynamicResource Brush.Text.Primary}"
                                            StrokeThickness="1.5" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button
                                Classes="NavIcon"
                                Classes.active="{Binding IsStatisticsActive}"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="{x:Static vm:ShellPage.Statistics}"
                                ToolTip.Tip="{Binding NavStatistics}">
                                <Viewbox Height="18" Width="18">
                                    <Canvas Height="24" Width="24">
                                        <Rectangle
                                            Canvas.Left="3"
                                            Canvas.Top="14"
                                            Fill="{DynamicResource Brush.Text.Secondary}"
                                            Height="7"
                                            RadiusX="1"
                                            RadiusY="1"
                                            Width="4" />
                                        <Rectangle
                                            Canvas.Left="10"
                                            Canvas.Top="8"
                                            Fill="{DynamicResource Brush.Text.Secondary}"
                                            Height="13"
                                            RadiusX="1"
                                            RadiusY="1"
                                            Width="4" />
                                        <Rectangle
                                            Canvas.Left="17"
                                            Canvas.Top="4"
                                            Fill="{DynamicResource Brush.Text.Secondary}"
                                            Height="17"
                                            RadiusX="1"
                                            RadiusY="1"
                                            Width="4" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button
                                Classes="NavIcon"
                                Classes.active="{Binding IsProfileActive}"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="{x:Static vm:ShellPage.Profile}"
                                ToolTip.Tip="{Binding NavProfile}">
                                <Viewbox Height="18" Width="18">
                                    <Canvas Height="24" Width="24">
                                        <Ellipse
                                            Canvas.Left="7"
                                            Canvas.Top="3"
                                            Fill="Transparent"
                                            Height="10"
                                            Stroke="{DynamicResource Brush.Text.Secondary}"
                                            StrokeThickness="1.7"
                                            Width="10" />
                                        <Path
                                            Data="M4,21 C4,16.5 8,14 12,14 C16,14 20,16.5 20,21"
                                            Fill="Transparent"
                                            Stroke="{DynamicResource Brush.Text.Secondary}"
                                            StrokeThickness="1.7" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button
                                Classes="NavIcon"
                                Classes.active="{Binding IsSettingsActive}"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="{x:Static vm:ShellPage.Settings}"
                                ToolTip.Tip="{Binding NavSettings}">
                                <Viewbox Height="18" Width="18">
                                    <Canvas Height="24" Width="24">
                                        <Ellipse
                                            Canvas.Left="8"
                                            Canvas.Top="8"
                                            Fill="Transparent"
                                            Height="8"
                                            Stroke="{DynamicResource Brush.Text.Secondary}"
                                            StrokeThickness="1.7"
                                            Width="8" />
                                        <Ellipse
                                            Canvas.Left="2"
                                            Canvas.Top="2"
                                            Fill="Transparent"
                                            Height="20"
                                            Stroke="{DynamicResource Brush.Text.Secondary}"
                                            StrokeDashArray="2,2.2"
                                            StrokeThickness="1.5"
                                            Width="20" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <Button
                            Classes="NavIcon Power"
                            Command="{Binding ExitAppCommand}"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            ToolTip.Tip="Power">
                            <Viewbox Height="18" Width="18">
                                <Canvas Height="24" Width="24">
                                    <Line
                                        EndPoint="12,12"
                                        StartPoint="12,3"
                                        Stroke="{DynamicResource Brush.Text.Danger}"
                                        StrokeLineCap="Round"
                                        StrokeThickness="2" />
                                    <Path
                                        Data="M7,6.5 A7,7 0 1 0 17,6.5"
                                        Fill="Transparent"
                                        Stroke="{DynamicResource Brush.Text.Danger}"
                                        StrokeLineCap="Round"
                                        StrokeThickness="1.8" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <ContentControl Content="{Binding CurrentPage}" Grid.Column="1" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
