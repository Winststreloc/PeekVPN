<UserControl
    d:DesignHeight="720"
    d:DesignWidth="1280"
    x:Class="PeekVPN.App.Views.SettingsPageView"
    x:DataType="vm:SettingsPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:PeekVPN.App.Localization"
    xmlns:vm="using:PeekVPN.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space.Xxxl}">
            <StackPanel Spacing="{StaticResource Space.Xs}">
                <Button
                    Classes="SettingsNavigation"
                    Classes.active="{Binding IsGeneralSelected}"
                    Command="{Binding SelectSectionCommand}"
                    CommandParameter="{x:Static vm:SettingsSection.General}"
                    Content="{x:Static lang:Strings.SettingsGeneralSection}" />
                <Button
                    Classes="SettingsNavigation"
                    Classes.active="{Binding IsAppearanceSelected}"
                    Command="{Binding SelectSectionCommand}"
                    CommandParameter="{x:Static vm:SettingsSection.Appearance}"
                    Content="{x:Static lang:Strings.SettingsAppearanceSection}" />
                <Button
                    Classes="SettingsNavigation"
                    Classes.active="{Binding IsVpnConnectionSelected}"
                    Command="{Binding SelectSectionCommand}"
                    CommandParameter="{x:Static vm:SettingsSection.VpnConnection}"
                    Content="{x:Static lang:Strings.SettingsVpnConnectionSection}" />

                <Button
                    Classes="SettingsNavigation"
                    Classes.active="{Binding IsKillSwitchSelected}"
                    Command="{Binding SelectSectionCommand}"
                    CommandParameter="{x:Static vm:SettingsSection.KillSwitch}"
                    Content="{x:Static lang:Strings.SettingsKillSwitchSection}" />

                <Button
                    Classes="SettingsNavigation"
                    Classes.active="{Binding IsSplitTunnelingSelected}"
                    Command="{Binding SelectSectionCommand}"
                    CommandParameter="{x:Static vm:SettingsSection.SplitTunneling}"
                    Content="{x:Static lang:Strings.SettingsSplitTunnelingSection}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxl}">

                <StackPanel IsVisible="{Binding IsGeneralSelected}">
                    <Border Classes="Card" Padding="{StaticResource Inset.Xs}">
                        <StackPanel>
                            <Grid
                                Classes="SettingRow"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE8A5;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsSendAppLogsTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsSendAppLogsDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsChecked="{Binding SendAppLogs}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="SettingDivider" />
                            <Grid
                                Classes="SettingRow"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE895;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsAutoUpdatesTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsAutoUpdatesDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsChecked="{Binding AutoUpdates}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="SettingDivider" />
                            <Grid
                                Classes="SettingRow"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE71D;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsAllowBackgroundProcessesTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsAllowBackgroundProcessesDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsChecked="{Binding AllowBackgroundProcesses}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="SettingDivider" />
                            <Grid
                                Classes="SettingRow Last"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE72C;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsResetSettingsTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsResetSettingsDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Classes="OutlineCta"
                                    Command="{Binding ResetSettingsCommand}"
                                    Content="{x:Static lang:Strings.SettingsResetSettingsButton}"
                                    Grid.Column="2"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsAppearanceSelected}">
                    <Border Classes="Card" Padding="{StaticResource Inset.Xs}">
                        <StackPanel>
                            <Grid
                                Classes="SettingRow"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE790;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsAppearanceTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsAppearanceDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    ItemsSource="{Binding AppearanceOptions}"
                                    SelectedItem="{Binding Appearance}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="SettingDivider" />
                            <Grid
                                Classes="SettingRow"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE7E7;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsShowNotificationsTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsShowNotificationsDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsChecked="{Binding ShowNotifications}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="SettingDivider" />
                            <Grid
                                Classes="SettingRow"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE7E8;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsAutoStartupTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsAutoStartupDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsChecked="{Binding AutoStartup}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="SettingDivider" />
                            <Grid
                                Classes="SettingRow"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE9A9;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsStayHiddenTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsStayHiddenDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsChecked="{Binding StayHidden}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel IsVisible="{Binding IsVpnConnectionSelected}">
                    <Border Classes="Card" Padding="{StaticResource Inset.Xs}">
                        <StackPanel>
                            <Grid
                                Classes="SettingRow"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE703;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsAutoConnectTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsAutoConnectDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsChecked="{Binding AutoConnect}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="SettingDivider" />
                            <Grid
                                Classes="SettingRow"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE916;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsAutoConnectTargetTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsAutoConnectTargetDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static lang:Strings.SettingsFastestServer}" VerticalAlignment="Center" />
                                    <ToggleSwitch IsChecked="{Binding AutoConnectUseFastestServer}" />
                                </StackPanel>
                            </Grid>
                            <Border Classes="SettingDivider" />
                            <Grid
                                Classes="SettingRow Last"
                                ColumnDefinitions="Auto,*,220"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE753;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsAutoConnectServerTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsAutoConnectServerDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    IsEnabled="{Binding IsAutoConnectServerSelectionEnabled}"
                                    ItemsSource="{Binding AutoConnectServers}"
                                    SelectedItem="{Binding AutoConnectServer}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="SettingDivider" />
                            <Grid
                                Classes="SettingRow Last"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE707;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsCustomDnsTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsCustomDnsDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsChecked="{Binding CustomDns}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="Card" Padding="{StaticResource Inset.Xs}">
                        <Grid
                            Classes="SettingRow Last"
                            ColumnDefinitions="Auto,*,220"
                            ColumnSpacing="{StaticResource Space.Sm}">
                            <Border
                                CornerRadius="{StaticResource Radius.Lg}"
                                Grid.Column="0"
                                Padding="{StaticResource Inset.Xs}">
                                <TextBlock
                                    FontFamily="{StaticResource SegoeIcons}"
                                    FontSize="{StaticResource Type.Title}"
                                    Text="&#xE774;"
                                    VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsVpnProtocolTitle}" />
                                <TextBlock
                                    Classes="SettingDescription"
                                    Text="{x:Static lang:Strings.SettingsVpnProtocolDescription}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="2"
                                ItemsSource="{Binding VpnProtocols}"
                                SelectedItem="{Binding VpnProtocol}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsKillSwitchSelected}">
                    <Border Classes="Card" Padding="{StaticResource Inset.Xs}">
                        <StackPanel>
                            <Grid
                                Classes="SettingRow"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE72E;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsKillSwitchTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsKillSwitchDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsChecked="{Binding KillSwitch}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="SettingDivider" />
                            <Grid
                                Classes="SettingRow Last"
                                ColumnDefinitions="Auto,*,220"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE8FD;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsKillSwitchModeTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsKillSwitchModeDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    ItemsSource="{Binding KillSwitchModes}"
                                    SelectedItem="{Binding SelectedKillSwitchMode}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsSplitTunnelingSelected}">
                    <Border Classes="Card" Padding="{StaticResource Inset.Xs}">
                        <StackPanel>
                            <Grid
                                Classes="SettingRow"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="{StaticResource Space.Sm}">
                                <Border
                                    CornerRadius="{StaticResource Radius.Lg}"
                                    Grid.Column="0"
                                    Padding="{StaticResource Inset.Xs}">
                                    <TextBlock
                                        FontFamily="{StaticResource SegoeIcons}"
                                        FontSize="{StaticResource Type.Title}"
                                        Text="&#xE968;"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="{StaticResource Space.Xxs}">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsSplitTunnelingTitle}" />
                                    <TextBlock
                                        Classes="SettingDescription"
                                        Text="{x:Static lang:Strings.SettingsSplitTunnelingDescription}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    IsChecked="{Binding SplitTunneling}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Margin="16,0,16,16" Spacing="16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsSplitTunnelingDomainsTitle}" />
                                            <TextBlock
                                                Classes="SettingDescription"
                                                Text="{x:Static lang:Strings.SettingsSplitTunnelingDomainsDescription}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox PlaceholderText="{x:Static lang:Strings.SettingsSplitTunnelingAddDomainWatermark}" Text="{Binding NewSplitTunnelingDomain}" />
                                            <Button
                                                Classes="OutlineCta"
                                                Command="{Binding AddSplitTunnelingDomainCommand}"
                                                Content="{x:Static lang:Strings.SettingsSplitTunnelingAddButton}"
                                                Grid.Column="1" />
                                        </Grid>
                                        <TextBlock
                                            Classes="SettingDescription"
                                            IsVisible="{Binding IsSplitTunnelingDomainsEmpty}"
                                            Text="{x:Static lang:Strings.SettingsSplitTunnelingDomainsEmpty}"
                                            TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding SplitTunnelingDomains}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Static lang:Strings.SettingsSplitTunnelingApplicationsTitle}" />
                                            <TextBlock
                                                Classes="SettingDescription"
                                                Text="{x:Static lang:Strings.SettingsSplitTunnelingApplicationsDescription}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox PlaceholderText="{x:Static lang:Strings.SettingsSplitTunnelingAddApplicationWatermark}" Text="{Binding NewSplitTunnelingApplication}" />
                                            <Button
                                                Classes="OutlineCta"
                                                Command="{Binding AddSplitTunnelingApplicationCommand}"
                                                Content="{x:Static lang:Strings.SettingsSplitTunnelingAddButton}"
                                                Grid.Column="1" />
                                        </Grid>
                                        <TextBlock
                                            Classes="SettingDescription"
                                            IsVisible="{Binding IsSplitTunnelingApplicationsEmpty}"
                                            Text="{x:Static lang:Strings.SettingsSplitTunnelingApplicationsEmpty}"
                                            TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding SplitTunnelingApplications}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>