<UserControl
    x:Class="PeekVPN.App.Views.WorkspaceView"
    x:DataType="vm:WorkspaceViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:vm="using:PeekVPN.App.ViewModels"
    xmlns:views="using:PeekVPN.App.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="14" RowDefinitions="*,Auto" RowSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="200" MaxWidth="280" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <views:ServerBrowserView DataContext="{Binding ServerBrowser}" />

        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="14">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="200" MinWidth="160" MaxWidth="240" />
                </Grid.ColumnDefinitions>
                <views:ConnectionPanelView DataContext="{Binding ConnectionPanel}" />
                <views:StatsSummaryView DataContext="{Binding StatsSummary}" Grid.Column="1" />
            </Grid>

            <views:MapView DataContext="{Binding Map}" Grid.Row="1" />
        </Grid>

        <views:FeatureCardsView DataContext="{Binding FeatureCards}" Grid.ColumnSpan="2" Grid.Row="1" />
    </Grid>
</UserControl>
