<UserControl
    d:DesignHeight="260"
    d:DesignWidth="520"
    x:Class="PeekVPN.App.Views.MapView"
    x:DataType="vm:MapViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:ctrl="using:PeekVPN.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PeekVPN.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d">
    <Border
        Classes="Card"
        MinHeight="180"
        Padding="{StaticResource Inset.Md}">
        <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource Space.Sm}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    FontSize="{StaticResource Type.BodyLg}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Text="{Binding Title}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Classes="Caption"
                    FontSize="{StaticResource Type.Caption}"
                    Foreground="{DynamicResource Brush.Text.Muted}"
                    IsVisible="{Binding ActiveServer, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Text="{Binding ActiveServer.DisplayName}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </Grid>

            <Border
                Background="{DynamicResource Brush.Map.Water}"
                ClipToBounds="True"
                CornerRadius="{StaticResource Radius.Xl}"
                Grid.Row="1"
                MinHeight="120">
                <ctrl:InteractiveMapControl
                    FocusTarget="{Binding FocusTarget}"
                    MarkerCommand="{Binding ActivateMarkerCommand}"
                    Markers="{Binding Markers}"
                    Margin="{StaticResource Inset.Sm}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
