<UserControl
    x:Class="PeekVPN.App.Views.ConnectionStates.DisconnectingStateView"
    x:DataType="vm:DisconnectingStateViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:conv="using:PeekVPN.App.Converters"
    xmlns:ctrl="using:PeekVPN.App.Controls"
    xmlns:vm="using:PeekVPN.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="{StaticResource Space.Sm}">
        <Grid ColumnDefinitions="40,*" ColumnSpacing="{StaticResource Space.Sm}" MinHeight="{StaticResource Size.Flag}">
            <Border Background="{DynamicResource Brush.Background.IconMuted}"
                    BorderBrush="{Binding State, Converter={x:Static conv:ConnectionStateToBrushConverter.Instance}, ConverterParameter=status}"
                    BorderThickness="{StaticResource Stroke.Live}"
                    ClipToBounds="True"
                    CornerRadius="{StaticResource Radius.Full}"
                    Height="{StaticResource Size.Flag}"
                    Width="{StaticResource Size.Flag}">
                <ctrl:SvgImage
                    HorizontalAlignment="Stretch"
                    RasterWidth="96"
                    SourceUri="{Binding FlagUri}"
                    Stretch="UniformToFill"
                    VerticalAlignment="Stretch" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="{StaticResource Type.TitleSm}" FontWeight="Bold" Text="{Binding Headline}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
        <TextBlock Foreground="{DynamicResource Brush.Text.Danger}" Text="{Binding LastError}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
