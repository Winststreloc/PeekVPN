<UserControl
    x:Class="PeekVPN.App.Views.ConnectionStates.ConnectingStateView"
    x:DataType="vm:ConnectingStateViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:conv="using:PeekVPN.App.Converters"
    xmlns:ctrl="using:PeekVPN.App.Controls"
    xmlns:vm="using:PeekVPN.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="{StaticResource Space.Sm}">
        <Grid ColumnDefinitions="40,*" ColumnSpacing="{StaticResource Space.Sm}" MinHeight="{StaticResource Size.Flag}">
            <Grid Height="{StaticResource Size.Flag}" Width="{StaticResource Size.Flag}">
                <Border Background="{DynamicResource Brush.Background.IconMuted}"
                        ClipToBounds="True"
                        CornerRadius="{StaticResource Radius.Xl}"
                        Height="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="32">
                    <ctrl:SvgImage
                        HorizontalAlignment="Stretch"
                        RasterWidth="96"
                        SourceUri="{Binding FlagUri}"
                        Stretch="UniformToFill"
                        VerticalAlignment="Stretch" />
                </Border>
                <Viewbox RenderTransformOrigin="50%,50%">
                    <Viewbox.RenderTransform>
                        <RotateTransform />
                    </Viewbox.RenderTransform>
                    <Viewbox.Styles>
                        <Style Selector="Viewbox">
                            <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="RotateTransform.Angle" Value="0" />
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="RotateTransform.Angle" Value="360" />
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Viewbox.Styles>
                    <Path Data="M20,2 A18,18 0 1,1 7.27,7.27"
                          Stroke="{Binding State, Converter={x:Static conv:ConnectionStateToBrushConverter.Instance}, ConverterParameter=status}"
                          StrokeLineCap="Round"
                          StrokeThickness="2.5" />
                </Viewbox>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="{StaticResource Type.TitleSm}" FontWeight="Bold" Text="{Binding Headline}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
        <TextBlock Foreground="{DynamicResource Brush.Text.Danger}" Text="{Binding LastError}" TextWrapping="Wrap" />
        <Button Classes="OutlineCta CompactConnectionAction" Command="{Binding CancelCommand}" Content="{Binding CancelText}" />
    </StackPanel>
</UserControl>
