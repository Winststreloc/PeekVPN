<UserControl
    x:Class="PeekVPN.App.Views.FeatureCardView"
    x:DataType="vm:FeatureCardViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:vm="using:PeekVPN.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Classes="Card" MinHeight="110" Padding="{StaticResource Inset.Md}">
        <StackPanel Spacing="{StaticResource Space.Sm}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border
                    Background="{DynamicResource Brush.Background.IconMuted}"
                    CornerRadius="{StaticResource Radius.Md}"
                    Height="34"
                    Width="34">
                    <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding IconText}" VerticalAlignment="Center" />
                </Border>
                <Border
                    Background="{DynamicResource Brush.Status.LiteBadge}"
                    CornerRadius="{StaticResource Radius.Md}"
                    Grid.Column="2"
                    Padding="{StaticResource Inset.Badge}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.Xs}">
                        <Ellipse
                            Fill="{DynamicResource Brush.Status.Success}"
                            Height="{StaticResource Size.Dot.Sm}"
                            IsVisible="{Binding IsActive}"
                            VerticalAlignment="Center"
                            Width="{StaticResource Size.Dot.Sm}" />
                        <TextBlock FontSize="{StaticResource Type.Label}" FontWeight="SemiBold" Text="{Binding Badge}" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock FontSize="{StaticResource Type.BodyLg}" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock
                FontSize="{StaticResource Type.Label}"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Text="{Binding Description}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
