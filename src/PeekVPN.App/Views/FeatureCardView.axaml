<UserControl
    x:Class="PeekVPN.App.Views.FeatureCardView"
    x:DataType="vm:FeatureCardViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:vm="using:PeekVPN.App.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Classes="Card" MinHeight="110" Padding="14">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Background="{DynamicResource Brush.Background.IconMuted}" CornerRadius="10" Height="34" Width="34">
                    <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding IconText}" VerticalAlignment="Center" />
                </Border>
                <Border Background="{DynamicResource Brush.Status.LiteBadge}" CornerRadius="10" Grid.Column="2" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Fill="{DynamicResource Brush.Status.Success}" Height="7" IsVisible="{Binding IsActive}"
                                 VerticalAlignment="Center" Width="7" />
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Badge}" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}"
                       Text="{Binding Description}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
