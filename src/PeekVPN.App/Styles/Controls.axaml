<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <Border>
            <StackPanel Spacing="{StaticResource Space.Sm}">
                <Button
                    Classes="PrimaryCta"
                    Height="44"
                    Width="88" />
                <Button
                    Classes="OutlineCta"
                    Height="44"
                    Width="88" />
                <Button
                    Classes="CompactConnectionAction"
                    Height="44"
                    Width="88" />
                <Button
                    Classes="IconAction"
                    Height="44"
                    Width="88" />
                <Button
                    Classes="GhostIcon"
                    Height="44"
                    Width="88" />
                <Button
                    Classes="DarkAction"
                    Height="44"
                    Width="88" />
                <Button
                    Classes="NavIcon"
                    Height="44"
                    Width="88" />
                <Button
                    Classes="SettingsNavigation"
                    Height="44"
                    Width="88" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontSize" Value="{StaticResource Type.Display}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize" Value="{StaticResource Type.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="TextBlock.Caption">
        <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    </Style>
    <Style Selector="TextBlock.Mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    </Style>

    <Style Selector="Button.PrimaryCta">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
        <Setter Property="Padding" Value="{StaticResource Inset.Lg.Squish}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Cta}" />
        <Setter Property="MinWidth" Value="{StaticResource Size.Cta.Min}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke.None}" />
    </Style>
    <Style Selector="Button.PrimaryCta:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.PrimaryHover}" />
    </Style>

    <Style Selector="Button.OutlineCta">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
        <Setter Property="Padding" Value="{StaticResource Inset.Lg.Squish}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Cta}" />
        <Setter Property="MinWidth" Value="{StaticResource Size.Cta.OutlineMin}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Card}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke.Accent}" />
    </Style>
    <Style Selector="Button.OutlineCta:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.NavActive}" />
    </Style>

    <Style Selector="Button.CompactConnectionAction">
        <Setter Property="Padding" Value="{StaticResource Inset.Cta.Compact}" />
    </Style>

    <Style Selector="Button.IconAction.Round">
        <Setter Property="Width" Value="{StaticResource Size.Icon.Lg}" />
        <Setter Property="Height" Value="{StaticResource Size.Icon.Lg}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Full}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Card}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke.Accent}" />
    </Style>
    <Style Selector="Button.IconAction.Round:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.NavActive}" />
    </Style>

    <Style Selector="Button.IconAction">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.IconMuted}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Width" Value="{StaticResource Size.Icon.Md}" />
        <Setter Property="Height" Value="{StaticResource Size.Icon.Md}" />
        <Setter Property="Padding" Value="{StaticResource Inset.None}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Icon}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke.None}" />
    </Style>
    <Style Selector="Button.IconAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.NavActive}" />
    </Style>

    <Style Selector="Button.GhostIcon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Width" Value="{StaticResource Size.Ghost.Width}" />
        <Setter Property="Height" Value="{StaticResource Size.Ghost.Height}" />
        <Setter Property="Padding" Value="{StaticResource Inset.None}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke.None}" />
    </Style>
    <Style Selector="Button.GhostIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.NavActive}" />
    </Style>

    <Style Selector="Button.DarkAction">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.ButtonDark}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnDark}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="{StaticResource Inset.Md.Squish}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Nav}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.NavIcon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Width" Value="{StaticResource Size.Icon.Xl}" />
        <Setter Property="Height" Value="{StaticResource Size.Icon.Xl}" />
        <Setter Property="Padding" Value="{StaticResource Inset.None}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Nav}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke.None}" />
    </Style>
    <Style Selector="Button.NavIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.NavActive}" />
    </Style>
    <Style Selector="Button.NavIcon.Active">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.NavActive}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="Button.NavIcon.active">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.NavActive}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="Button.NavIcon.Power">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Danger}" />
    </Style>

    <Style Selector="Button.GhostLink">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Link}" />
        <Setter Property="Padding" Value="{StaticResource Inset.None}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="TextBox.SearchBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Search}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke.None}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Search}" />
        <Setter Property="Padding" Value="{StaticResource Inset.Search}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Search}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Card}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke.Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Icon}" />
        <Setter Property="Padding" Value="{StaticResource Inset.Sm}" />
    </Style>

    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Card}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Card}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke.Hairline}" />
        <Setter Property="Padding" Value="{StaticResource Inset.Card}" />
    </Style>
    <Style Selector="Border.NoticeCard">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Upsell}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Card}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke.Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Notice}" />
        <Setter Property="Padding" Value="{StaticResource Inset.Notice}" />
    </Style>
    <Style Selector="Border.StatListItem">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Nav}" />
        <Setter Property="Padding" Value="{StaticResource Inset.Sm}" />
    </Style>
    <Style Selector="Grid.SettingRow">
        <Setter Property="Margin" Value="{StaticResource Inset.SettingRow}" />
    </Style>
    <Style Selector="Grid.SettingRow.Last">
        <Setter Property="Margin" Value="{StaticResource Inset.SettingRow.Last}" />
    </Style>
    <Style Selector="Border.SettingDivider">
        <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="16,0" />
    </Style>
    <Style Selector="TextBlock.SettingDescription">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    </Style>
    <Style Selector="TextBlock.SettingsNavigationLabel">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Margin" Value="12,0,0,8" />
    </Style>
    <Style Selector="Button.SettingsNavigation">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke.None}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Icon}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.SettingsNavigation:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.NavActive}" />
    </Style>
    <Style Selector="Button.SettingsNavigation.active">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.NavActive}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
    </Style>

</Styles>
