<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Background.App">#F5F1EA</Color>
    <Color x:Key="Color.Background.Surface">#FFFCF7</Color>
    <Color x:Key="Color.Background.Card">#FFFFFF</Color>
    <Color x:Key="Color.Background.Sidebar">#EEE8DE</Color>
    <Color x:Key="Color.Background.NavActive">#E3D4BE</Color>
    <Color x:Key="Color.Background.Search">#EAE2D6</Color>
    <Color x:Key="Color.Background.Upsell">#EAE2D6</Color>
    <Color x:Key="Color.Background.ButtonDark">#241A12</Color>
    <Color x:Key="Color.Background.IconMuted">#DED4C7</Color>

    <Color x:Key="Color.Text.Primary">#21170F</Color>
    <Color x:Key="Color.Text.Secondary">#665546</Color>
    <Color x:Key="Color.Text.Muted">#8F8173</Color>
    <Color x:Key="Color.Text.OnAccent">#21170F</Color>
    <Color x:Key="Color.Text.OnDark">#FFF9F0</Color>
    <Color x:Key="Color.Text.Danger">#C83F36</Color>
    <Color x:Key="Color.Text.Link">#7A4F18</Color>

    <Color x:Key="Color.Accent.Primary">#F2B928</Color>
    <Color x:Key="Color.Accent.PrimaryHover">#FFC94D</Color>
    <Color x:Key="Color.Brand.Shield">#D89A00</Color>

    <Color x:Key="Color.Status.Danger">#D93D35</Color>
    <Color x:Key="Color.Status.Success">#299B61</Color>
    <Color x:Key="Color.Status.Warning">#E0A800</Color>
    <Color x:Key="Color.Status.Neutral">#817568</Color>
    <Color x:Key="Color.Status.ActiveBadge">#E7F6EC</Color>
    <Color x:Key="Color.Status.ActiveBadgeText">#2F8F57</Color>
    <Color x:Key="Color.Status.LiteBadge">#EEE4D6</Color>

    <Color x:Key="Color.Server.Connected">#D8F0E2</Color>
    <Color x:Key="Color.Server.ConnectedHover">#E8F7EE</Color>
    <Color x:Key="Color.Server.Connecting">#E4E0DA</Color>
    <Color x:Key="Color.Server.ConnectingHover">#EEEBE6</Color>
    <Color x:Key="Color.Server.Paused">#F5E6B8</Color>
    <Color x:Key="Color.Server.PausedHover">#FAF0D2</Color>
    <Color x:Key="Color.Server.BorderConnected">#3FA66A</Color>
    <Color x:Key="Color.Server.BorderConnecting">#8A8074</Color>
    <Color x:Key="Color.Server.BorderPaused">#D4A017</Color>
    <Color x:Key="Color.Map.Land">#E0D4C4</Color>
    <Color x:Key="Color.Map.Water">#F7F1E8</Color>
    <Color x:Key="Color.Map.Marker">#C9A227</Color>

    <Color x:Key="Color.Border.Subtle">#E4D8C8</Color>
    <Color x:Key="Color.Border.Card">#EDE3D6</Color>
